# ============================================================================
# 1.20.1 Forge 移植版
#
# 与仓库根目录的 .gitignore 互补——根目录那份是按「1.21 主线」写的，
# 这里补上 1.20.1 工程特有的路径。两份都会生效。
# ============================================================================

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.vs
.project
.classpath
.settings/
eclipse/
out/
bin/

# --- 运行时（开发环境）---
# `run/` 是 gradlew runClient/runServer 的工作目录，里面有
# eula.txt、server.properties、世界存档、日志，全部属于本机状态，
# 不该进版本库
run/
logs/
*.log

# --- ForgeGradle 反编译产物 ---
# `temp/` 存放映射后的 Minecraft 源码（解压自官方 jar），
# 单份就有 30 MB 以上，且任何机器都能由 Gradle 自行重新生成
temp/

# --- datagen 缓存 ---
src/generated/**/.cache

# --- 本地专用 ---
tools/
libs/
__pycache__/
*.pyc
3d_models/
blockbench/
texture_converter.py
.trae/

# --- OS ---
.DS_Store
Thumbs.db
