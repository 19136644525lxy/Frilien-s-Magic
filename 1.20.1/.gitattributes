# ============================================================================
# 1.20.1 Forge 移植版 —— 行尾约定
#
# Windows 上 core.autocrlf=true 时，Git 检出会把文本文件转成 CRLF。
# 这对 Java/JSON 无所谓，但 Shell 脚本必须保持 LF——
# 否则在 Linux/macOS 上 clone 之后 gradlew 会因 `\r` 而无法执行
# （典型报错：`/bin/sh^M: bad interpreter`）。
# ============================================================================

# --- Shell 脚本一律 LF ---
*.sh        text eol=lf
gradlew     text eol=lf

# --- Windows 批处理一律 CRLF ---
*.bat       text eol=crlf
gradlew.bat text eol=crlf

# --- 文本文件规范化（提交时统一成 LF 存储）---
*.java      text
*.kt        text
*.gradle    text
*.properties text
*.json      text
*.toml      text
*.mcmeta    text
*.md        text
*.fsh       text
*.vsh       text

# --- 二进制文件：不要让 Git 碰 ---
*.jar       binary
*.png       binary
*.jpg       binary
*.ogg       binary
*.zip       binary

# --- datagen 缓存：总是 LF，避免只因行尾就显示"已修改" ---
src/generated/**/.cache/* text eol=lf
